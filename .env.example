# Copy to .env and edit.  `docker compose` reads .env automatically.

# Signs login tokens (backend/auth.py). CHANGE THIS — the default in code is a
# known dev placeholder, so leaving it means anyone can forge a session token.
JWT_SECRET=change-me-to-a-long-random-string

# Where the browser reaches the backend. Vite inlines this at BUILD time, so
# after changing it you must rebuild:  docker compose build frontend
VITE_API_URL=http://localhost:8000
