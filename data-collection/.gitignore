# Runtime data (regenerated by the pipeline — not committed)
data/raw/
data/register/
data/cache/
data/interim/
data/quarantine/
data/styles/
data/features/
data/models/
data/rankings/
data/overrides/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Local backups made when regenerating the database (never commit — huge binaries)
data/*.old-backup
data/*.old-backup/
data/*backup*

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
